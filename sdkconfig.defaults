# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32000

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=4
# enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_HOST=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BLUEDROID_ENABLED=n
CONFIG_BTDM_CTRL_ENABLED=n
#
#CONFIG_FREERTOS_UNICORE=y
#CONFIG_FREERTOS_PORT_EXTENSIONS=n
# Enable PSRAM
#CONFIG_ESP_SYSTEM_SINGLE_CORE_MODE=y

CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_NETWORK_PROV_BLE_FORCE_ENCRYPTION=y
CONFIG_NETWORK_PROV_BLE_SEC_CONN=y

# Use picolibc (the IDF 6.0 default) instead of newlib. The esprit C/C++ is
# compiled against the matching libc headers: native_code/extra_code build.rs
# detect CONFIG_LIBC_PICOLIBC in sdkconfig.h and inject the toolchain's
# picolibc.specs, so the esp_libc platform_include wrappers resolve against
# picolibc exactly as they do for IDF's own components.
CONFIG_LIBC_PICOLIBC=y
# swindle/esprit requires FreeRTOS trace facility (configUSE_TRACE_FACILITY=1)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Fix ESP32-C3 internal flash bootloop & flash size
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Fix multiple DROM segments bootloop (remove .eh_frame on ESP-IDF v6)
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=0
CONFIG_ESP_SYSTEM_USE_EH_FRAME=n
